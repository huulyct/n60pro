#!/bin/sh

# Đợi hệ thống sinh xong cấu hình network mặc định (tránh lỗi chưa có file)
[ -f /etc/config/network ] || exit 1

# ====================================================================
# 1. DỌN SẠCH VÀ TÁI TẠO CẤU HÌNH WAN (Tên interface: wana)
# ====================================================================

# Lưu lại tên cổng vật lý của WAN mặc định
WAN_DEVICE=$(uci -q get network.wan.device)

# Xóa sạch mọi interface rác có tên bắt đầu bằng "wan" (wan, wan6, wan_4...)
for iface in $(uci show network | awk -F'[.=]' '/=interface/ {print $2}'); do
    case "$iface" in
        wan*) 
            uci -q delete network."$iface" 
            ;;
    esac
done

# Khởi tạo interface PPPoE mới với tên chính xác là 'wana'
if [ -n "$WAN_DEVICE" ]; then
    uci set network.wana='interface'
    uci set network.wana.device="$WAN_DEVICE"
    uci set network.wana.proto='pppoe'
    uci set network.wana.username='c710_gftth_tunt162'
    uci set network.wana.password='O8WIYG'
    uci set network.wana.mtu='1492'
    # uci set network.wana.dns_metric='100'
    uci set network.wana.metric='100'
    uci set network.wana.multipath='off'
    
    # Chặn IPv6 và DNS của nhà mạng
    uci set network.wana.ipv6='0'
    uci set network.wana.peerdns='0' 
fi

# ====================================================================
# 2. CẤU HÌNH WIREGUARD CLIENT (wg0)
# ====================================================================

# uci -q delete network.wg0
# uci set network.wg0="interface"
# uci set network.wg0.proto="wireguard"
# uci set network.wg0.private_key="PRIVATE_KEY_CUA_ROUTER"
