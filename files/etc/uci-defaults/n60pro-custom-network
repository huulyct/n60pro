# uci -q delete network.wireguard_wg0 
# uci set network.wireguard_wg0="wireguard_wg0"
# uci set network.wireguard_wg0.public_key="PUBLIC_KEY_CUA_SERVER"
# uci set network.wireguard_wg0.endpoint_host="IP_HOAC_DOMAIN_SERVER"
# uci set network.wireguard_wg0.endpoint_port="51820"
# uci set network.wireguard_wg0.route_allowed_ips="1"
# uci add_list network.wireguard_wg0.allowed_ips="0.0.0.0/0"
# uci set network.wireguard_wg0.persistent_keepalive="25"

# ====================================================================
# 3. THÊM 'wana' VÀ 'wg0' VÀO FIREWALL ZONE 'wan'
# ====================================================================

. /lib/functions.sh
config_load firewall

cfg_add_to_wan_zone() {
    local cfg="$1"
    local name
    config_get name "$cfg" name
    
    if [ "$name" = "wan" ]; then
        uci add_list firewall."$cfg".network='wana'
        # uci add_list firewall."$cfg".network='wg0'
    fi
}
config_foreach cfg_add_to_wan_zone zone

# ====================================================================
# 4. CẤU HÌNH WI-FI ĐỘNG (CHỈ BẬT 5G, WPA3 THUẦN)
# ====================================================================

[ -f /etc/config/wireless ] || wifi config
config_load wireless

change_wifi() {
    local config="$1"
    local device
    config_get device "$config" device

    local band
    config_get band "$device" band

    if [ "$band" = "2g" ]; then
        uci set wireless."$device".disabled='1' # Tắt 2.4GHz
        
    elif [ "$band" = "5g" ]; then
        uci set wireless."$device".disabled='0' # Bật 5GHz
        uci set wireless."$config".ssid='DKM VIETTEL'
        uci set wireless."$config".encryption='sae' # WPA3-SAE
        uci set wireless."$config".key='12344321'
        uci set wireless."$config".ieee80211w='2' # PMF = Required (Bắt buộc cho WPA3)
    fi
}
config_foreach change_wifi wifi-iface

# ====================================================================
# 5. DỌN SẠCH CẤU HÌNH MWAN3 (Giữ nguyên Rule trống, xóa các thành phần khác)
# ====================================================================

if [ -f /etc/config/mwan3 ]; then
    while uci -q delete mwan3.@interface[0]; do :; done
    while uci -q delete mwan3.@member[0]; do :; done
    while uci -q delete mwan3.@policy[0]; do :; done
    while uci -q delete mwan3.@rule[0]; do :; done
fi

# ====================================================================
# 6. CẤU HÌNH DNS-OVER-HTTPS (CLOUDFLARE)
# ====================================================================

if [ -f /etc/config/https-dns-proxy ]; then
    while uci -q delete https-dns-proxy.@https-dns-proxy[0]; do :; done
    
    uci set https-dns-proxy.cloudflare="https-dns-proxy"
    uci set https-dns-proxy.cloudflare.bootstrap_dns="1.1.1.1,1.0.0.1"
    uci set https-dns-proxy.cloudflare.resolver_url="https://cloudflare-dns.com/dns-query"
    uci set https-dns-proxy.cloudflare.listen_addr="127.0.0.1"
    uci set https-dns-proxy.cloudflare.listen_port="5053"
    
    uci commit https-dns-proxy
    /etc/init.d/https-dns-proxy enable
fi

if [ -f /etc/config/dhcp ]; then
    while uci -q delete dhcp.@dnsmasq[0].server; do :; done
    uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#5053'
    uci set dhcp.@dnsmasq[0].noresolv='1'
    uci set dhcp.@dnsmasq[0].cachesize='1000'
    uci set dhcp.@dnsmasq[0].no_negcache='1'
fi

# ====================================================================
# 7. LƯU LẠI TOÀN BỘ CẤU HÌNH VÀ DỌN DẸP SCRIPT
# ====================================================================

uci commit network
uci commit firewall
uci commit wireless
uci commit dhcp
[ -f /etc/config/mwan3 ] && uci commit mwan3

# Tự động hủy script sau khi chạy để đảm bảo chỉ chạy 1 lần duy nhất ở First Boot
rm -f /etc/uci-defaults/99-custom-network
exit 0
